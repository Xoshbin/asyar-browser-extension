{
  "id": "org.asyar.browser",
  "name": "Browser",
  "version": "1.1.1",
  "type": "extension",
  "description": "Search tabs, bookmarks, and history across your paired browsers; open URLs in any paired browser.",
  "author": "Asyar",
  "icon": "🌐",
  "searchable": true,
  "asyarSdk": "^4.0.0",
  "permissions": [
    "browser:tabs.read",
    "browser:tabs.write",
    "browser:bookmarks.read",
    "browser:history.read"
  ],
  "commands": [
    {
      "id": "open-url",
      "name": "Open URL",
      "description": "Open a URL in a paired browser (or the OS default).",
      "icon": "🌐",
      "mode": "background",
      "arguments": [
        {
          "name": "url",
          "type": "text",
          "placeholder": "https://…",
          "default": ""
        }
      ]
    },
    {
      "id": "command-bar",
      "name": "Browser",
      "description": "Search tabs, history, bookmarks; open URLs and web searches — the browser command bar.",
      "icon": "🌐",
      "mode": "view",
      "component": "CommandBar",
      "actions": []
    }
  ],
  "preferences": [
    {
      "name": "openTarget",
      "title": "Open new content in",
      "description": "Which browser receives new tabs, URLs, and web searches opened from the command bar.",
      "type": "dropdown",
      "default": "most-recent",
      "data": [
        {
          "value": "most-recent",
          "title": "Most recently active browser"
        },
        {
          "value": "chrome",
          "title": "Chrome"
        },
        {
          "value": "brave",
          "title": "Brave"
        },
        {
          "value": "arc",
          "title": "Arc"
        },
        {
          "value": "edge",
          "title": "Edge"
        },
        {
          "value": "vivaldi",
          "title": "Vivaldi"
        },
        {
          "value": "firefox",
          "title": "Firefox"
        },
        {
          "value": "safari",
          "title": "Safari"
        }
      ]
    }
  ],
  "background": {
    "main": "dist/worker.js"
  }
}